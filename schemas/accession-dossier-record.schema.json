{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/accession-dossier-record/v1",
  "title": "6529 Network Museum accession dossier record base",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "record_control", "record_id", "record_type"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"type": "string", "minLength": 1},
    "record_control": {
      "type": "object",
      "required": ["revision", "record_status", "constructor", "review"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "record_status": {"enum": ["constructed", "reviewed"]},
        "constructor": {"type": "object", "required": ["actor_id", "role", "constructed_at"]},
        "review": {"type": ["object", "null"]}
      }
    }
  }
}

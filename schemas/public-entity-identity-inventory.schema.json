{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/public-entity-identity-inventory-v1.json",
  "title": "6529 Network Museum public entity identity inventory",
  "type": "object",
  "properties": {
    "$schema": {"const": "https://6529networkmuseum.org/schemas/public-entity-identity-inventory-v1.json"},
    "inventory_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "identity_policy": {"type": "string", "minLength": 1},
    "entity_id_patterns": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "required_bootstrap_curated_acquisitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string", "pattern": "^6529NM-CA-[0-9]{4}-[0-9]{3}$"},
          "preferred_label": {"type": "string", "minLength": 1},
          "public_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "source_aliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        },
        "required": ["entity_id", "preferred_label", "public_slug", "source_aliases"],
        "unevaluatedProperties": false
      }
    },
    "acquisition_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "canonical_entity_id": {"type": "string", "minLength": 1},
          "alias_kind": {"enum": ["program_route_key", "source_program", "proposal", "accession_lot", "accession_record"]}
        },
        "required": ["alias", "canonical_entity_id", "alias_kind"],
        "unevaluatedProperties": false
      }
    },
    "work_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "alias": {"type": "string", "minLength": 1},
          "canonical_entity_id": {"type": "string", "pattern": "^6529NM-W-[0-9]{4}$"},
          "alias_kind": {"enum": ["accession_object", "program_outcome", "proposal_candidate_object"]}
        },
        "required": ["alias", "canonical_entity_id", "alias_kind"],
        "unevaluatedProperties": false
      }
    },
    "route_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "legacy_route": {"type": "string", "pattern": "^/museum/network/[^\\s]+$"},
          "canonical_route": {"type": "string", "pattern": "^/museum/network/[^\\s]+$"},
          "canonical_entity_id": {"type": "string", "minLength": 1}
        },
        "required": ["legacy_route", "canonical_route", "canonical_entity_id"],
        "unevaluatedProperties": false
      }
    },
    "public_slug_inventory": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "entity_type": {"enum": ["ARTIST", "ORGANIZATION", "PROJECT_OR_SERIES", "CURATED_ACQUISITION", "ACQUISITION_PROGRAM", "RESEARCH_PUBLICATION", "WORK"]},
          "preferred_label": {"type": "string", "minLength": 1},
          "public_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "canonical_route": {"type": "string", "pattern": "^/museum/network/(artists|organizations|projects|acquisitions|research|works|acquisition-programs)/[^\\s]+$"}
        },
        "required": ["entity_id", "entity_type", "preferred_label", "public_slug", "canonical_route"],
        "unevaluatedProperties": false
      }
    }
  },
  "required": ["$schema", "inventory_version", "identity_policy", "entity_id_patterns", "required_bootstrap_curated_acquisitions", "acquisition_aliases", "work_aliases", "route_aliases", "public_slug_inventory"],
  "unevaluatedProperties": false
}

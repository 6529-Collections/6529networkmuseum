  "$defs": {
    "schemaPath": {
      "const": "../../../../../../schemas/magnum-scholarship-machine-record.schema.json"
    },
    "recordControl": {
      "$ref": "https://6529.network/museum/schemas/proposed-gift-register/v1#/$defs/recordControl"
    },
    "amendmentHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revision", "superseded_at", "supersedes", "prior_payload_sha256"],
        "properties": {
          "revision": {"type": "integer", "minimum": 1},
          "superseded_at": {"type": "string", "format": "date-time"},
          "supersedes": {"$ref": "#/$defs/sha256"},
          "prior_payload_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "text": {"type": "string", "minLength": 1},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "observedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "workId": {"type": "string", "pattern": "^6529NM-W-00(?:24|25|26|27|28)$"},
    "activeMediaSourceAmendment": {
      "type": "object", "additionalProperties": false,
      "required": ["amendment_id", "path", "status", "observed_at"],
      "properties": {
        "amendment_id": {"const": "6529NM-MEDIA-CONT-AMD-2026-08-12-001"},
        "path": {"const": "records/proposed-gifts/6529NM-PG-2026-001/public/scholarship/machine/media-source-continuity-amendment.json"},
        "status": {"const": "active_downstream_accession_display_source"},
        "observed_at": {"const": "2026-08-12T07:37:56.984246Z"}
      }
    },
    "mediaContinuityAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["presentation_authority_path", "browser_review_finding_path", "decision_scope"],
      "properties": {
        "presentation_authority_path": {"const": "records/proposed-gifts/6529NM-PG-2026-001/public/scholarship/dossiers/public-presentation.md"},
        "browser_review_finding_path": {"const": "records/proposed-gifts/6529NM-PG-2026-001/public/status-amendments/2026-08-12-media-source-continuity.md"},
        "decision_scope": {"const": "downstream_accession_technical_review_and_public_display_delivery"}
      }
    },
    "supersededMachineRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "prior_revision", "prior_file_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^records/proposed-gifts/6529NM-PG-2026-001/public/scholarship/machine/(?:integration-map|wave-media-join|work-projections)\\.json$"},
        "prior_revision": {"const": 2},
        "prior_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mediaContinuityWork": {
      "type": "object", "additionalProperties": false,
      "required": ["work_entity_id", "media_reference_entity_id", "prior_media_payload_sha256", "historical_wave_uri", "display_token_source_uri", "sha256", "bytes", "width", "height", "fixity_verified_at", "display_policy"],
      "properties": {
        "work_entity_id": {"$ref": "#/$defs/workId"},
        "media_reference_entity_id": {"type": "string", "pattern": "^6529NM-MED-(?:0003|0041|0042|0043|0044)$"},
        "prior_media_payload_sha256": {"$ref": "#/$defs/sha256"},
        "historical_wave_uri": {"type": "string", "format": "uri", "pattern": "^https://d3lqz0a4bldqgf\\.cloudfront\\.net/drops/"},
        "display_token_source_uri": {"type": "string", "format": "uri", "pattern": "^https://arweave\\.net/[A-Za-z0-9_-]{43}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "fixity_verified_at": {"const": "2026-08-08T10:15:02.0167151Z"},
        "display_policy": {"const": "historical_wave_locator_preserved_token_source_used_for_accession_display"}
      }
    },
    "mediaContinuityWork0024": {"allOf": [{"$ref": "#/$defs/mediaContinuityWork"}, {"properties": {"work_entity_id": {"const": "6529NM-W-0024"}, "media_reference_entity_id": {"const": "6529NM-MED-0003"}}, "required": ["work_entity_id", "media_reference_entity_id"]}]},
    "mediaContinuityWork0025": {"allOf": [{"$ref": "#/$defs/mediaContinuityWork"}, {"properties": {"work_entity_id": {"const": "6529NM-W-0025"}, "media_reference_entity_id": {"const": "6529NM-MED-0041"}}, "required": ["work_entity_id", "media_reference_entity_id"]}]},
    "mediaContinuityWork0026": {"allOf": [{"$ref": "#/$defs/mediaContinuityWork"}, {"properties": {"work_entity_id": {"const": "6529NM-W-0026"}, "media_reference_entity_id": {"const": "6529NM-MED-0042"}}, "required": ["work_entity_id", "media_reference_entity_id"]}]},
    "mediaContinuityWork0027": {"allOf": [{"$ref": "#/$defs/mediaContinuityWork"}, {"properties": {"work_entity_id": {"const": "6529NM-W-0027"}, "media_reference_entity_id": {"const": "6529NM-MED-0043"}}, "required": ["work_entity_id", "media_reference_entity_id"]}]},
    "mediaContinuityWork0028": {"allOf": [{"$ref": "#/$defs/mediaContinuityWork"}, {"properties": {"work_entity_id": {"const": "6529NM-W-0028"}, "media_reference_entity_id": {"const": "6529NM-MED-0044"}}, "required": ["work_entity_id", "media_reference_entity_id"]}]},
    "nonEmptyStringArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "publicationPathContract": {
      "type": "object", "additionalProperties": false,
      "required": ["visitor_facing_wp3_path_allowed", "canonical_namespace_bound", "review_required_before_publication", "publication_actions"],
      "properties": {
        "visitor_facing_wp3_path_allowed": {"type": "boolean"},
        "canonical_namespace_bound": {"type": "boolean"},
        "review_required_before_publication": {"type": "boolean"},
        "publication_actions": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "statusObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "observation_id", "observed_at", "payload_sha256"],
      "properties": {
        "record_type": {"const": "WAVE_STATUS_OBSERVATION"},
        "observation_id": {"$ref": "#/$defs/text"},
        "observed_at": {"$ref": "#/$defs/observedAt"},
        "payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "publicationObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "observation_id", "observed_at", "payload_sha256", "receipt_path", "receipt_sha256", "binding_status"],
      "properties": {
        "record_type": {"const": "WAVE_PUBLICATION_OBSERVATION"},
        "observation_id": {"$ref": "#/$defs/text"},
        "observed_at": {"$ref": "#/$defs/observedAt"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_path": {"$ref": "#/$defs/text"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "binding_status": {"$ref": "#/$defs/text"},
        "required_before_media_join_is_current": {"type": "boolean"}
      }
    },
    "supplementalEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "observed_at", "payload_sha256", "path", "file_sha256", "role"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/text"},
        "observed_at": {"$ref": "#/$defs/observedAt"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"$ref": "#/$defs/text"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "role": {"$ref": "#/$defs/text"}
      }
    },
    "priorObservation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_status", "observed_at", "historical_only"],
          "properties": {"source_status": {"$ref": "#/$defs/text"}, "observed_at": {"$ref": "#/$defs/observedAt"}, "historical_only": {"const": true}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["drop_type", "rank", "realtime_rating", "rater_count", "observed_at", "historical_only", "selection_established"],
          "properties": {
            "drop_type": {"$ref": "#/$defs/text"}, "rank": {"type": "integer"}, "realtime_rating": {"type": "integer"},
            "rater_count": {"type": "integer"}, "observed_at": {"$ref": "#/$defs/observedAt"},
            "historical_only": {"const": true}, "selection_established": {"type": "boolean"}
          }
        }
      ]
    },
    "liveGovernanceObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "drop_id", "serial_no", "drop_type", "rank", "realtime_rating", "rater_count", "observed_at", "selection_established", "public_status", "lifecycle_status", "prior_observation", "status_boundary"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/text"}, "drop_id": {"type": "string", "format": "uuid"},
        "serial_no": {"type": "integer", "minimum": 1}, "drop_type": {"$ref": "#/$defs/text"},
        "rank": {"type": "integer", "minimum": 1}, "realtime_rating": {"type": "integer"}, "rater_count": {"type": "integer", "minimum": 0},
        "observed_at": {"$ref": "#/$defs/observedAt"}, "selection_established": {"type": "boolean"},
        "public_status": {"$ref": "#/$defs/text"}, "lifecycle_status": {"$ref": "#/$defs/text"},
        "prior_observation": {"$ref": "#/$defs/priorObservation"}, "status_boundary": {"$ref": "#/$defs/nonEmptyStringArray"}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/accession-media-presentation/v2",
  "title": "6529 Network Museum accession media presentation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "record_control",
    "record_type",
    "schema_profile",
    "accession_lot_id",
    "generated_at",
    "transform",
    "delivery",
    "rights_boundary",
    "items"
  ],
  "properties": {
    "$schema": {
      "const": "../../../../schemas/accession-media-presentation-v2.schema.json"
    },
    "record_control": { "$ref": "#/$defs/record_control" },
    "record_type": { "const": "ACCESSION_MEDIA_PRESENTATION" },
    "schema_profile": { "const": "6529NM_ACCESSION_MEDIA_PRESENTATION_V2" },
    "accession_lot_id": {
      "type": "string",
      "pattern": "^6529NM\\.[0-9]{4}\\.[0-9]{3}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "transform": { "$ref": "#/$defs/transform" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority_record_id",
        "authority_path",
        "cdn_base_url",
        "cache_control",
        "key_profile",
        "overwrite_policy"
      ],
      "properties": {
        "status": {
          "enum": [
            "prepared_for_contextual_museum_display_pending_review",
            "approved_for_contextual_museum_display"
          ]
        },
        "authority_record_id": {
          "type": "string",
          "pattern": "^6529NM\\.[0-9]{4}\\.[0-9]{3}\\.DISPLAY-[0-9]{2}$"
        },
        "authority_path": {
          "type": "string",
          "pattern": "^records/accessions/6529NM\\.[0-9]{4}\\.[0-9]{3}/public/web-presentation-authority\\.md$"
        },
        "cdn_base_url": {
          "const": "https://d3lqz0a4bldqgf.cloudfront.net"
        },
        "cache_control": { "const": "public, max-age=31536000, immutable" },
        "key_profile": { "type": "string", "minLength": 1 },
        "overwrite_policy": { "type": "string", "minLength": 1 }
      }
    },
    "rights_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_originals",
        "technical_transformation",
        "no_general_reuse"
      ],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "source_originals": { "type": "string", "minLength": 1 },
        "technical_transformation": { "type": "string", "minLength": 1 },
        "no_general_reuse": { "type": "string", "minLength": 1 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "record_status", "constructor", "review"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "record_status": { "enum": ["constructed", "reviewed"] },
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_id", "role", "constructed_at"],
          "properties": {
            "actor_id": { "type": "string", "minLength": 1 },
            "role": { "const": "constructor" },
            "constructed_at": { "type": "string", "format": "date-time" }
          }
        },
        "review": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "actor_id",
                "role",
                "reviewed_at",
                "reviewed_commit",
                "outcome",
                "payload_sha256"
              ],
              "properties": {
                "actor_id": { "type": "string", "minLength": 1 },
                "role": { "const": "reviewer" },
                "reviewed_at": { "type": "string", "format": "date-time" },
                "reviewed_commit": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "outcome": { "const": "approved" },
                "payload_sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "implementation",
        "format",
        "quality",
        "method",
        "widths",
        "resize_filter",
        "upscale",
        "orientation",
        "colour_management",
        "icc_profile_sha256",
        "metadata"
      ],
      "properties": {
        "profile": { "const": "6529NM_WEB_PRESENTATION_WEBP_V2_Q82_M6_FIXED_ICC" },
        "implementation": { "type": "string", "pattern": "^Pillow [0-9]+\\.[0-9]+\\.[0-9]+$" },
        "format": { "const": "image/webp" },
        "quality": { "const": 82 },
        "method": { "const": 6 },
        "widths": { "const": [640, 1280, 2400] },
        "resize_filter": { "const": "Lanczos" },
        "upscale": { "const": false },
        "orientation": { "type": "string", "minLength": 1 },
        "colour_management": { "type": "string", "minLength": 1 },
        "icc_profile_sha256": { "$ref": "#/$defs/sha256" },
        "metadata": { "type": "string", "minLength": 1 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_entity_id",
        "media_reference_entity_id",
        "source",
        "presentation"
      ],
      "properties": {
        "work_entity_id": {
          "type": "string",
          "pattern": "^6529NM-W-[0-9]{4}$"
        },
        "media_reference_entity_id": {
          "type": "string",
          "pattern": "^6529NM-MED-[0-9]{4}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "url",
            "mime_type",
            "sha256",
            "byte_size",
            "pixel_width",
            "pixel_height",
            "exif_orientation_applied",
            "colour_profile_status"
          ],
          "properties": {
            "role": { "const": "fixity_verified_token_source" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "mime_type": { "enum": ["image/jpeg", "image/png", "image/webp"] },
            "sha256": { "$ref": "#/$defs/sha256" },
            "byte_size": { "type": "integer", "minimum": 1 },
            "pixel_width": { "type": "integer", "minimum": 2400 },
            "pixel_height": { "type": "integer", "minimum": 1 },
            "exif_orientation_applied": { "type": "boolean" },
            "colour_profile_status": { "type": "string", "minLength": 1 }
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "alt_text",
            "alt_text_status",
            "public_widths",
            "derivatives"
          ],
          "properties": {
            "role": { "const": "web_presentation_surrogate" },
            "alt_text": { "type": "string", "minLength": 20 },
            "alt_text_status": { "const": "reviewed_accessibility_description" },
            "public_widths": { "const": [640, 1280, 2400] },
            "derivatives": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/derivative" }
            }
          }
        }
      }
    },
    "derivative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "mime_type",
        "sha256",
        "byte_size",
        "repository_path",
        "url",
        "cache_control"
      ],
      "properties": {
        "width": { "enum": [640, 1280, 2400] },
        "height": { "type": "integer", "minimum": 1 },
        "mime_type": { "const": "image/webp" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_size": { "type": "integer", "minimum": 1 },
        "repository_path": {
          "type": "string",
          "pattern": "^media/accessions/6529NM\\.[0-9]{4}\\.[0-9]{3}/6529NM-W-[0-9]{4}/[0-9a-f]{64}/webp-v2-q82-m6-fixed-icc/(640|1280|2400)\\.webp$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://d3lqz0a4bldqgf\\.cloudfront\\.net/museum/accessions/6529NM\\.[0-9]{4}\\.[0-9]{3}/"
        },
        "cache_control": { "const": "public, max-age=31536000, immutable" }
      }
    }
  }
}

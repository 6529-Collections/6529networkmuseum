{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/rights-expression-registry-v1.json",
  "type": "object",
  "properties": {
    "$schema": {"const": "../../schemas/rights-expression-registry.schema.json"},
    "registry_type": {"const": "6529NM_RIGHTS_EXPRESSION_REGISTRY"},
    "registry_version": {"const": "1.0.0"},
    "published_at": {"type": "string", "format": "date-time"},
    "actions": {
      "const": [
        "display_the_work",
        "publish_online",
        "publish_in_print",
        "make_preservation_copies",
        "share_an_adaptation",
        "make_commercial_use"
      ]
    },
    "use_status_definitions": {
      "type": "object",
      "properties": {
        "allowed": {"type": "string", "minLength": 1},
        "allowed_with_conditions": {"type": "string", "minLength": 1},
        "not_licensed": {"type": "string", "minLength": 1},
        "status_only": {"type": "string", "minLength": 1},
        "case_by_case": {"type": "string", "minLength": 1}
      },
      "required": ["allowed", "allowed_with_conditions", "not_licensed", "status_only", "case_by_case"],
      "unevaluatedProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "creative_commons_data_repository": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/creativecommons/cc-legal-tools-data$"},
        "creative_commons_data_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "creative_commons_license_guide": {"type": "string", "format": "uri"},
        "rightsstatements_documentation": {"type": "string", "format": "uri"},
        "rightsstatements_usage_guidelines": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["creative_commons_data_repository", "creative_commons_data_commit", "creative_commons_license_guide", "rightsstatements_documentation", "rightsstatements_usage_guidelines", "observed_at"],
      "unevaluatedProperties": false
    },
    "expressions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {"$ref": "#/$defs/expression"}
    },
    "object_assignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/objectAssignment"}
    },
    "program_notes": {
      "type": "array",
      "items": {"$ref": "#/$defs/programNote"}
    }
  },
  "required": ["$schema", "registry_type", "registry_version", "published_at", "actions", "use_status_definitions", "sources", "expressions", "object_assignments", "program_notes"],
  "unevaluatedProperties": false,
  "$defs": {
    "useStatus": {"enum": ["allowed", "allowed_with_conditions", "not_licensed", "status_only", "case_by_case"]},
    "useMatrix": {
      "type": "object",
      "properties": {
        "display_the_work": {"$ref": "#/$defs/useStatus"},
        "publish_online": {"$ref": "#/$defs/useStatus"},
        "publish_in_print": {"$ref": "#/$defs/useStatus"},
        "make_preservation_copies": {"$ref": "#/$defs/useStatus"},
        "share_an_adaptation": {"$ref": "#/$defs/useStatus"},
        "make_commercial_use": {"$ref": "#/$defs/useStatus"}
      },
      "required": ["display_the_work", "publish_online", "publish_in_print", "make_preservation_copies", "share_an_adaptation", "make_commercial_use"],
      "unevaluatedProperties": false
    },
    "legalCode": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "pattern": "^docs/rights/legal-texts/[a-z0-9.-]+\\.txt$"},
        "source_uri": {"type": "string", "format": "uri", "pattern": "^https://raw\\.githubusercontent\\.com/creativecommons/cc-legal-tools-data/[0-9a-f]{40}/"},
        "publication_uri": {"type": "string", "format": "uri", "pattern": "^https://creativecommons\\.org/"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "required": ["path", "source_uri", "publication_uri", "sha256"],
      "unevaluatedProperties": false
    },
    "expression": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "label": {"type": "string", "minLength": 1},
        "short_label": {"type": "string", "minLength": 1},
        "group": {"enum": ["creative_commons_license", "creative_commons_tool", "rights_statement", "copyright_case", "custom_license"]},
        "instrument_kind": {"enum": ["public_license", "public_domain_dedication", "public_domain_mark", "descriptive_status", "no_public_license", "custom_terms"]},
        "version": {"type": ["string", "null"]},
        "spdx_id": {"type": ["string", "null"]},
        "canonical_uri": {"type": ["string", "null"], "format": "uri"},
        "legal_code": {"anyOf": [{"$ref": "#/$defs/legalCode"}, {"type": "null"}]},
        "summary": {"type": "string", "minLength": 30},
        "museum_can": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 8}},
        "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
        "visitor_note": {"type": "string", "minLength": 20},
        "use_matrix": {"$ref": "#/$defs/useMatrix"}
      },
      "required": ["id", "label", "short_label", "group", "instrument_kind", "version", "spdx_id", "canonical_uri", "legal_code", "summary", "museum_can", "conditions", "boundaries", "visitor_note", "use_matrix"],
      "unevaluatedProperties": false
    },
    "objectAssignment": {
      "type": "object",
      "properties": {
        "object_id": {"type": "string", "pattern": "^6529NM\\.[0-9]{4}\\.[0-9]{3}\\.[0-9]{2}$"},
        "expression_id": {"type": "string"},
        "rights_record_path": {"type": "string", "pattern": "^records/accessions/.+/rights/.+\\.json$"},
        "evidence_basis": {"type": "string", "minLength": 20}
      },
      "required": ["object_id", "expression_id", "rights_record_path", "evidence_basis"],
      "unevaluatedProperties": false
    },
    "programNote": {
      "type": "object",
      "properties": {
        "program_id": {"type": "string", "minLength": 1},
        "expression_id": {"type": "string"},
        "effective_status": {"const": "conditional_not_yet_effective"},
        "explanation": {"type": "string", "minLength": 30}
      },
      "required": ["program_id", "expression_id", "effective_status", "explanation"],
      "unevaluatedProperties": false
    }
  }
}

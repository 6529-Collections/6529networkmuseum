{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/object-record-v1.json",
  "$defs": {
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "hash": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "nonEmpty": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stringArray": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
    "sourceHeads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "casey_research_head": {"$ref": "#/$defs/commit"},
        "control_plane_head": {"$ref": "#/$defs/commit"},
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"}
        }
      },
      "oneOf": [
        {"required": ["casey_research_head", "control_plane_head"]},
        {"required": ["source_record_ids"]}
      ]
    },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_type", "evidence_class", "preferred_name", "source_refs"],
      "properties": {
        "claim_type": {"$ref": "#/$defs/nonEmpty"},
        "evidence_class": {"enum": ["A", "B", "C", "D", "E"]},
        "preferred_name": {"$ref": "#/$defs/nonEmpty"},
        "source_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "combinationStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_count", "invocation_range", "invocation_zero_code", "sequenced_combination_invocations", "reviewed_generator_table_entries", "object_invocation", "object_code", "interpretive_boundary"],
      "properties": {
        "token_count": {"type": "integer", "minimum": 0},
        "invocation_range": {"$ref": "#/$defs/nonEmpty"},
        "invocation_zero_code": {"$ref": "#/$defs/nonEmpty"},
        "sequenced_combination_invocations": {"$ref": "#/$defs/nonEmpty"},
        "reviewed_generator_table_entries": {"type": "integer", "minimum": 0},
        "object_invocation": {"type": "integer", "minimum": 0},
        "object_code": {"$ref": "#/$defs/nonEmpty"},
        "interpretive_boundary": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edition_size", "license_claim_status", "name", "platform", "platform_metadata_license_label", "release_year", "script_type_and_version"],
      "properties": {
        "edition_size": {"type": "integer", "minimum": 0},
        "edition_logic": {"$ref": "#/$defs/nonEmpty"},
        "date_conflict": {"$ref": "#/$defs/nonEmpty"},
        "edition_statement": {"$ref": "#/$defs/nonEmpty"},
        "license_claim_status": {"$ref": "#/$defs/nonEmpty"},
        "name": {"$ref": "#/$defs/nonEmpty"},
        "platform": {"$ref": "#/$defs/nonEmpty"},
        "platform_metadata_license_label": {"$ref": "#/$defs/nonEmpty"},
        "release_year": {"type": "integer", "minimum": 1900, "maximum": 3000},
        "script_type_and_version": {"$ref": "#/$defs/nonEmpty"},
        "combination_structure": {"$ref": "#/$defs/combinationStructure"}
      }
    },
    "metadataSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixity_scope", "keccak256", "metadata_token_name", "observed_at", "raw_capture_path", "raw_capture_sha256", "sha256"],
      "properties": {
        "fixity_scope": {"$ref": "#/$defs/nonEmpty"},
        "keccak256": {"$ref": "#/$defs/hash"},
        "metadata_token_name": {"$ref": "#/$defs/nonEmpty"},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "raw_capture_path": {"$ref": "#/$defs/nonEmpty"},
        "raw_capture_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "action"],
      "properties": {"input": {"$ref": "#/$defs/nonEmpty"}, "action": {"$ref": "#/$defs/nonEmpty"}}
    },
    "observationTranscript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "reviewed_commit", "raw_response_bytes_retained"],
      "properties": {
        "uri": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "reviewed_commit": {"$ref": "#/$defs/commit"},
        "raw_response_bytes_retained": {"type": "boolean"}
      }
    },
    "generatorSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_observed", "preservation_gate", "raw_capture_status", "sha256", "status", "uri", "interaction_map", "interaction_review_status", "observation_transcript"],
      "properties": {
        "dependency_observed": {"$ref": "#/$defs/nonEmpty"},
        "preservation_gate": {"$ref": "#/$defs/nonEmpty"},
        "raw_capture_status": {"$ref": "#/$defs/nonEmpty"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "status": {"$ref": "#/$defs/nonEmpty"},
        "uri": {"type": "string", "format": "uri"},
        "interaction_map": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
        "interaction_review_status": {"$ref": "#/$defs/nonEmpty"},
        "automatic_behavior": {"$ref": "#/$defs/nonEmpty"},
        "documentation_discrepancies": {"$ref": "#/$defs/stringArray"},
        "observation_transcript": {"$ref": "#/$defs/observationTranscript"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artist_statement", "documented_fact", "evidence_class", "museum_interpretation", "technical_observation"],
      "properties": {
        "artist_statement": {"$ref": "#/$defs/nonEmpty"},
        "documented_fact": {"$ref": "#/$defs/nonEmpty"},
        "evidence_class": {"$ref": "#/$defs/nonEmpty"},
        "museum_interpretation": {"$ref": "#/$defs/nonEmpty"},
        "technical_observation": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "uri", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/nonEmpty"}, "uri": {"type": "string", "format": "uri"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "publicationRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_release_commit", "path", "uri", "sha256", "scope"],
      "properties": {
        "published_release_commit": {"$ref": "#/$defs/commit"},
        "path": {"$ref": "#/$defs/nonEmpty"},
        "uri": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "scope": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "packageCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bound_files", "raw_files", "derived_files", "descriptor_results", "source_tokens", "trait_rows"],
      "properties": {
        "bound_files": {"type": "integer", "minimum": 0}, "raw_files": {"type": "integer", "minimum": 0},
        "derived_files": {"type": "integer", "minimum": 0}, "descriptor_results": {"type": "integer", "minimum": 0},
        "source_tokens": {"type": "integer", "minimum": 0}, "trait_rows": {"type": "integer", "minimum": 0}
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "path", "uri", "descriptor_sha256", "result_sha256", "source_token_count", "trait_row_count"],
      "properties": {
        "collection": {"$ref": "#/$defs/nonEmpty"}, "path": {"$ref": "#/$defs/nonEmpty"}, "uri": {"type": "string", "format": "uri"},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"},
        "source_token_count": {"type": "integer", "minimum": 0}, "trait_row_count": {"type": "integer", "minimum": 0}
      }
    },
    "traitSourcePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_source_commit", "publication_semantics", "publication_release", "path", "package_manifest", "descriptor_manifest", "counts", "descriptors", "integrity_note"],
      "properties": {
        "published_source_commit": {"$ref": "#/$defs/commit"}, "publication_semantics": {"$ref": "#/$defs/nonEmpty"},
        "publication_release": {"$ref": "#/$defs/publicationRelease"}, "path": {"$ref": "#/$defs/nonEmpty"},
        "package_manifest": {"$ref": "#/$defs/fileRef"}, "descriptor_manifest": {"$ref": "#/$defs/fileRef"},
        "counts": {"$ref": "#/$defs/packageCounts"}, "descriptors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/descriptor"}},
        "integrity_note": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "traitAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "marketplace_metrics", "non_claims", "source_package", "descriptor"],
      "properties": {
        "status": {"const": "transparent_linked_descriptors_available"}, "method": {"$ref": "#/$defs/nonEmpty"},
        "marketplace_metrics": {"const": "not_used"}, "non_claims": {"$ref": "#/$defs/stringArray"},
        "source_package": {"$ref": "#/$defs/traitSourcePackage"}, "descriptor": {"$ref": "#/$defs/descriptor"}
      }
    },
    "titleBinding": {
      "type": "object",
      "properties": {
        "object_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
        "status": {"type": "string", "enum": ["pending", "executed", "not_applicable"]},
        "instrument_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "custodian_reference": {"type": "string", "minLength": 1},
        "transfer_transaction": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "block_number": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "from": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "to": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
        "bound_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "basis": {"type": "string", "minLength": 1}
      },
      "required": ["object_id", "status", "instrument_sha256", "custodian_reference", "transfer_transaction", "block_number", "from", "to", "bound_at", "basis"],
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "executed"}}, "required": ["status"]},
          "then": {
            "properties": {
              "instrument_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "transfer_transaction": {"$ref": "#/$defs/hash"},
              "block_number": {"type": "integer", "minimum": 0},
              "from": {"$ref": "#/$defs/address"},
              "to": {"$ref": "#/$defs/address"},
              "bound_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rightsGrant": {
      "type": "object",
      "properties": {
        "grant_status": {"type": "string", "enum": ["granted", "granted_with_conditions", "denied", "unspecified", "not_applicable"]},
        "basis": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "required": ["grant_status", "basis", "observed_at"],
      "unevaluatedProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "token": {"type": "string", "enum": ["green", "amber", "red", "not_assessed"]},
        "metadata": {"type": "string", "enum": ["green", "amber", "red", "not_assessed"]},
        "script": {"type": "string", "enum": ["green", "amber", "red", "not_assessed", "not_applicable"]},
        "dependencies": {"type": "string", "enum": ["green", "amber", "red", "not_assessed", "not_applicable"]},
        "rendering": {"type": "string", "enum": ["green", "amber", "red", "not_assessed"]},
        "behavior": {"type": "string", "enum": ["green", "amber", "red", "not_assessed", "not_applicable"]},
        "documentation": {"type": "string", "enum": ["green", "amber", "red", "not_assessed"]},
        "protocol_state": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "narrative": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "required": ["token", "metadata", "script", "dependencies", "rendering", "behavior", "documentation", "protocol_state", "method", "narrative", "observed_at"],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/commonPayload"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "WORK_DESCRIPTION"},
        "schema_id": {"const": "0x5bb3543c4c007f4396474b74ec81dd8bca13028b6d945020e4b48ff236b26a3c"},
        "object_id": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}\\.\\d+$"},
        "accession_lot_id": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}$"},
        "title": {"type": "string", "minLength": 1},
        "creator": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "credit_line": {"type": "string", "minLength": 1},
        "chain_identity": {
          "type": "object",
          "properties": {
            "caip19": {"type": "string", "pattern": "^eip155:[0-9]+/(erc721|erc1155):0x[0-9a-fA-F]{40}/[0-9]+$"},
            "chain_id": {"type": "integer", "minimum": 1},
            "contract": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
            "token_id": {"type": "string", "pattern": "^[0-9]+$"},
            "token_standard": {"type": "string", "enum": ["ERC-721", "ERC-1155", "legacy_evm", "non_evm"]},
            "mint_transaction": {"$ref": "#/$defs/hash"},
            "acquisition_transaction": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
            "custody_receipt_transaction": {"$ref": "#/$defs/hash"},
            "custody_receipt_block": {"type": "integer", "minimum": 0},
            "custody_receipt_log": {"type": "integer", "minimum": 0},
            "raw_art_blocks": {
              "type": "object",
              "properties": {
                "engine_type": {"type": "string", "minLength": 1},
                "project_id": {"type": "integer", "minimum": 0},
                "tokenID": {"type": "integer", "minimum": 0}
              },
              "required": ["engine_type", "project_id", "tokenID"],
              "unevaluatedProperties": false
            },
            "decoded_invocation": {"type": "integer", "minimum": 0},
            "project_artist_address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
            "token_hash": {"$ref": "#/$defs/hash"},
            "metadata_uri": {"type": "string", "pattern": "^https://[^\\s]+$"},
            "generator_uri": {"type": "string", "pattern": "^https://[^\\s]+$"},
            "metadata_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "generator_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "custody_account": {"type": "string", "pattern": "^eip155:[0-9]+:0x[0-9a-fA-F]{40}$"},
            "custody_status": {"type": "string", "enum": ["pending", "verified", "unverified", "not_applicable"]},
            "custody_verified_at": {"type": "string", "format": "date-time"},
            "custody_block": {"type": "integer", "minimum": 0}
          },
          "required": ["caip19", "chain_id", "contract", "token_id", "token_standard", "acquisition_transaction", "custody_receipt_transaction", "custody_receipt_block", "custody_receipt_log", "custody_account", "custody_status", "custody_verified_at", "custody_block"],
          "unevaluatedProperties": false
        },
        "title_binding": {"$ref": "#/$defs/titleBinding"},
        "rights": {
          "type": "object",
          "properties": {
            "reproduction": {"$ref": "#/$defs/rightsGrant"},
            "publication": {"$ref": "#/$defs/rightsGrant"},
            "exhibition": {"$ref": "#/$defs/rightsGrant"},
            "print": {"$ref": "#/$defs/rightsGrant"},
            "derivative_use": {"$ref": "#/$defs/rightsGrant"},
            "ai_training": {"$ref": "#/$defs/rightsGrant"},
            "preservation": {"$ref": "#/$defs/rightsGrant"},
            "migration_emulation": {"$ref": "#/$defs/rightsGrant"},
            "accessibility": {"$ref": "#/$defs/rightsGrant"}
          },
          "required": ["reproduction", "publication", "exhibition", "print", "derivative_use", "ai_training", "preservation", "migration_emulation", "accessibility"],
          "unevaluatedProperties": false
        },
        "condition": {"$ref": "#/$defs/condition"},
        "current_state": {"type": "string", "enum": ["offered", "authorized", "acquired", "received_onchain", "accessioned", "catalogued", "technically_verified", "preservation_complete", "display_ready"]},
        "state_history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "state": {"type": "string", "enum": ["offered", "authorized", "acquired", "received_onchain", "accessioned", "catalogued", "technically_verified", "preservation_complete", "display_ready"]},
              "observed_at": {"type": "string", "format": "date-time"},
              "evidence_refs": {"type": "array", "items": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"}, "uniqueItems": true}
            },
            "required": ["state", "observed_at", "evidence_refs"],
            "unevaluatedProperties": false
          }
        },
        "state_history_semantics": {"type": "string", "minLength": 1},
        "preservation": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["not_started", "in_progress", "complete"]},
            "package_uri": {"type": "string", "pattern": "^(https://|ipfs://|ar://)[^\\s]+$"},
            "fixity_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "render_environment": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"}
          },
          "required": ["status", "package_uri", "fixity_sha256", "render_environment", "observed_at"],
          "unevaluatedProperties": false
        },
        "display": {
          "type": "object",
          "properties": {
            "status": {"type": "string", "enum": ["not_assessed", "ready", "ready_with_conditions", "not_ready"]},
            "manifest_uri": {"type": "string", "pattern": "^(https://|ipfs://|ar://)[^\\s]+$"},
            "credit_line": {"type": "string", "minLength": 1},
            "observed_at": {"type": "string", "format": "date-time"}
          },
          "required": ["status", "manifest_uri", "credit_line", "observed_at"],
          "unevaluatedProperties": false
        },
        "record_status": {"enum": ["constructed", "review_pending", "reviewed", "superseded"]},
        "review_status": {"enum": ["pending_independent_review", "reviewed", "superseded"]},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source": {"$ref": "#/$defs/sourceHeads"},
        "artist": {"$ref": "#/$defs/artist"},
        "project": {"$ref": "#/$defs/project"},
        "metadata_snapshot": {"$ref": "#/$defs/metadataSnapshot"},
        "generator_snapshot": {"$ref": "#/$defs/generatorSnapshot"},
        "claims": {"$ref": "#/$defs/claims"},
        "museum_observations": {
          "type": "object",
          "properties": {
            "observed_at": {"type": "string", "format": "date-time"},
            "observation_record": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}\\.VO-\\d{2}$"},
            "documentation_surrogate": {"type": "string", "minLength": 1},
            "static_visual_observation": {"type": "string", "minLength": 1},
            "live_behavior_observation": {"type": "string", "minLength": 1},
            "interpretive_boundary": {"type": "string", "minLength": 1}
          },
          "required": ["observed_at", "observation_record", "documentation_surrogate", "static_visual_observation", "live_behavior_observation", "interpretive_boundary"],
          "unevaluatedProperties": false
        },
        "visual_observation_record": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}\\.VO-\\d{2}$"},
        "trait_analysis": {"$ref": "#/$defs/traitAnalysis"},
        "evidence_grade": {"type": "string", "minLength": 1},
        "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["object_id", "accession_lot_id", "title", "creator", "medium", "credit_line", "chain_identity", "title_binding", "rights", "condition", "current_state", "state_history", "state_history_semantics", "preservation", "display"]
    }
  ],
  "unevaluatedProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/controlled-vocabularies-v1.json",
  "title": "6529 Network Museum controlled vocabularies",
  "type": "object",
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "vocabulary_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "subject_domain_prefix": {"type": "string", "const": "6529networkmuseum.subject"},
    "hash_algorithms": {"type": "object", "properties": {"HASH_KECCAK256": {"const": 1}, "HASH_SHA256": {"const": 2}}, "required": ["HASH_KECCAK256", "HASH_SHA256"], "additionalProperties": false},
    "canonicalization": {
      "type": "object",
      "properties": {
        "name": {"const": "RFC8785_JCS"},
        "id": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "profile": {"const": "museum-i-json-v1"}
      },
      "required": ["name", "id", "profile"],
      "additionalProperties": false
    },
    "endpoint_policy": {
      "type": "object",
      "properties": {
        "mode": {"const": "resolve_at_fetch"},
        "scheme": {"const": "https"},
        "require_all_a_aaaa_global": {"const": true},
        "pin_connected_ip": {"const": true},
        "recheck_every_redirect": {"const": true},
        "unknown_hostname": {"const": "reject"},
        "allowed_methods": {"const": ["GET", "HEAD", "POST"]},
        "allowed_ports": {"const": [443]},
        "max_redirects": {"const": 5},
        "max_response_bytes": {"const": 1048576},
        "max_request_bytes": {"const": 1048576},
        "max_url_length": {"const": 8192},
        "connect_timeout_seconds": {"const": 10},
        "read_timeout_seconds": {"const": 20},
        "resolver_profile": {"const": "system_getaddrinfo"},
        "resolver_revision": {"const": "python-socket.getaddrinfo-v1"},
        "address_selection": {"const": "lowest_numeric"}
      },
      "required": ["mode", "scheme", "require_all_a_aaaa_global", "pin_connected_ip", "recheck_every_redirect", "unknown_hostname", "allowed_methods", "allowed_ports", "max_redirects", "max_response_bytes", "max_request_bytes", "max_url_length", "connect_timeout_seconds", "read_timeout_seconds", "resolver_profile", "resolver_revision", "address_selection"],
      "additionalProperties": false
    },
    "record_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}},
    "schema_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}},
    "schema_paths": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-z0-9-]+\\.schema\\.json$"}},
    "evidence_classes": {"type": "array", "const": ["A", "B", "C", "D", "E"]},
    "visibility": {"type": "array", "const": ["public", "restricted"]},
    "actor_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "governance_source_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "decision_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "program_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "outcome_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "acquisition_methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "workflow_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "workflow_transitions": {"type": "object", "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}},
    "condition_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "title_binding_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "custody_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "rights_grant_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "rights_use_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_entity_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "public_entity_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_page_exposures": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "public_work_lifecycle_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_work_mint_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "curated_acquisition_lifecycle_statuses": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}},
    "public_media_roles": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "public_media_rights_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_media_source_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_media_ui_affordances": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_independent_fact_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "public_relation_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "public_relation_assertion_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "relation_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source_entity_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "target_entity_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "max_targets_per_source": {"type": ["integer", "null"], "minimum": 1},
          "max_sources_per_target": {"type": ["integer", "null"], "minimum": 1},
          "allowed_qualifier_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "required_qualifier_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "reserved": {"type": "boolean"}
        },
        "required": ["source_entity_types", "target_entity_types", "max_targets_per_source", "max_sources_per_target", "allowed_qualifier_fields", "required_qualifier_fields"],
        "additionalProperties": false
      }
    }
  },
  "required": ["$schema", "vocabulary_version", "subject_domain_prefix", "hash_algorithms", "canonicalization", "endpoint_policy", "record_types", "schema_ids", "schema_paths", "evidence_classes", "visibility", "actor_roles", "governance_source_statuses", "decision_statuses", "program_statuses", "outcome_statuses", "acquisition_methods", "workflow_states", "workflow_transitions", "condition_statuses", "title_binding_statuses", "custody_statuses", "rights_grant_statuses", "rights_use_classes", "public_entity_types", "public_entity_statuses", "public_page_exposures", "public_work_lifecycle_statuses", "public_work_mint_statuses", "curated_acquisition_lifecycle_statuses", "public_media_roles", "public_media_rights_statuses", "public_media_source_statuses", "public_media_ui_affordances", "public_independent_fact_statuses", "public_relation_types", "public_relation_assertion_statuses", "relation_profiles"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/accession-lot-v1.json",
  "allOf": [
    {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/commonPayload"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "ACCESSION_LOT"},
        "schema_id": {"const": "0xefb854ed3d30d5f3c03815c8b8abc70ae24738b2712e2cfd3a228a8c811939d4"},
        "accession_number": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}$"},
        "acquisition_method": {"type": "string", "enum": ["donation", "purchase", "bequest", "exchange", "transfer"]},
        "acceptance_date": {"type": "string", "format": "date-time"},
        "object_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}\\.\\d+$"}, "uniqueItems": true},
        "governing_references": {"type": "array", "items": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"}, "uniqueItems": true},
        "record_status": {"const": "constructed"},
        "review_status": {"const": "pending_independent_review"},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "intake_status": {"type": "string", "enum": ["accepted_for_accession_processing", "received_onchain"]},
        "formal_acceptance_status": {"type": "string", "enum": ["not_formally_accepted", "formally_accepted"]},
        "formal_acceptance_date": {"type": "string", "format": "date-time"},
        "gift_acceptance_authorization_record": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
        "accession_status": {"type": "string", "enum": ["not_complete", "complete"]},
        "controlled_decision": {"type": "object", "additionalProperties": true},
        "collection_curatorial_statement": {"type": "object", "additionalProperties": true},
        "object_identities": {"type": "array", "minItems": 7, "items": {"type": "object", "additionalProperties": true}},
        "receipt_summary": {"type": "object", "additionalProperties": true},
        "provenance_schedule": {"$ref": "https://6529.network/museum/schemas/transaction-provenance/v1#/$defs/provenanceSchedule"},
        "donation_rights_schedule": {"type": "object", "additionalProperties": true},
        "preservation_manifest": {"type": "object", "additionalProperties": true},
        "public_inventory": {"type": "array", "minItems": 7, "items": {"type": "object", "additionalProperties": true}},
        "restricted_registrar_annex": {"type": "object", "additionalProperties": true},
        "constructor_controls": {"type": "object", "additionalProperties": true},
        "trait_analysis": {"type": "object", "additionalProperties": true},
        "remaining_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "source_manifest": {"type": "object", "additionalProperties": true},
        "evidence_grade": {"type": "string", "minLength": 1}
      },
      "required": ["accession_number", "acquisition_method", "acceptance_date", "object_ids", "governing_references"]
    }
  ]
}

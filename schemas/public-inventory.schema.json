{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/public-inventory/v1",
  "title": "6529 Network Museum public inventory",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "record_control", "record_id", "record_type", "accession_lot_id", "objects"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "public_inventory"},
    "record_control": {"type": "object", "required": ["revision", "record_status", "constructor", "review"]},
    "accession_lot_id": {"type": "string", "minLength": 1},
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["object_id"],
        "properties": {
          "object_id": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/accession-statement/v1",
  "title": "6529 Network Museum accession statement",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "record_control", "record_id", "record_type", "accession_lot_id", "controlled_decision", "object_schedule", "remaining_gates"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "accession_statement"},
    "record_control": {"type": "object", "required": ["revision", "record_status", "constructor", "review"]},
    "accession_lot_id": {"type": "string", "minLength": 1},
    "controlled_decision": {"type": "object", "required": ["outcome", "current_state", "basis"]},
    "object_schedule": {"type": "array", "minItems": 7},
    "remaining_gates": {"type": "array", "minItems": 1}
  }
}

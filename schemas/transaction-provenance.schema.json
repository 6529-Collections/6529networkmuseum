{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/transaction-provenance/v1",
  "title": "6529 Network Museum transaction and provenance schedule",
  "$defs": {
    "bytes32": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "address": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
    "dateTime": {"type": "string", "format": "date-time"},
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 1},
        "media_type": {"type": "string", "minLength": 1},
        "byte_mode": {"const": "raw"}
      },
      "required": ["path", "sha256", "size", "media_type", "byte_mode"]
    },
    "receiptEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "response": {"$ref": "#/$defs/artifactReference"},
        "acquisition": {"$ref": "#/$defs/artifactReference"}
      },
      "required": ["response", "acquisition"]
    },
    "provenanceEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block": {"type": "integer", "minimum": 0},
        "block_hash": {"$ref": "#/$defs/bytes32"},
        "direct_rpc_verified": {"type": "boolean"},
        "from": {"$ref": "#/$defs/address"},
        "kind": {"type": "string", "enum": ["mint", "transfer", "museum_receipt"]},
        "log": {"type": "integer", "minimum": 0},
        "receipt_status": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
        "time": {"$ref": "#/$defs/dateTime"},
        "to": {"$ref": "#/$defs/address"},
        "tx": {"$ref": "#/$defs/bytes32"},
        "verification": {"type": "string", "enum": ["indexer_observed", "direct_rpc_verified"]}
      },
      "required": ["block", "direct_rpc_verified", "from", "kind", "log", "receipt_status", "time", "to", "tx", "verification"],
      "allOf": [
        {
          "if": {"properties": {"verification": {"const": "direct_rpc_verified"}}},
          "then": {"required": ["block_hash"]}
        },
        {
          "if": {"properties": {"direct_rpc_verified": {"const": true}}},
          "then": {"required": ["block_hash"]}
        },
        {
          "if": {"properties": {"verification": {"const": "indexer_observed"}}},
          "then": {"properties": {"direct_rpc_verified": {"const": false}}}
        }
      ]
    },
    "objectSchedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chain_object": {"type": "string", "pattern": "^eip155:[0-9]+/erc721:0x[0-9a-fA-F]{40}/[0-9]+$"},
        "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenanceEvent"}},
        "object_id": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}\\.\\d+$"}
      },
      "required": ["chain_object", "events", "object_id"]
    },
    "provenanceSchedule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$schema": {"type": "string", "minLength": 1},
        "accession_lot_id": {"type": "string", "pattern": "^6529NM\\.\\d{4}\\.\\d{3}$"},
        "common_receipt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "block_hash": {"$ref": "#/$defs/bytes32"},
            "block_number": {"type": "integer", "minimum": 0},
            "block_time": {"$ref": "#/$defs/dateTime"},
            "evidence": {"$ref": "#/$defs/receiptEvidence"},
            "evidence_grade": {"type": "string", "enum": ["A", "B", "C", "D", "E"]},
            "log_indices": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
            "museum_custody_address": {"$ref": "#/$defs/address"},
            "purpose": {"type": "string", "minLength": 1},
            "receipt_status": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
            "transaction_from": {"$ref": "#/$defs/address"},
            "transaction_hash": {"$ref": "#/$defs/bytes32"},
            "transaction_to": {"$ref": "#/$defs/address"},
            "transfer_count": {"type": "integer", "minimum": 1},
            "verification": {"const": "direct_rpc_verified"}
          },
          "required": ["block_hash", "block_number", "block_time", "evidence", "evidence_grade", "log_indices", "museum_custody_address", "purpose", "receipt_status", "transaction_from", "transaction_hash", "transaction_to", "transfer_count", "verification"]
        },
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "historical_event_boundary": {"type": "string", "minLength": 1},
        "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/objectSchedule"}},
        "provenance_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "record_control": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "constructor": {"type": "object", "required": ["actor_id", "constructed_at", "role"]},
            "record_status": {"const": "constructed"},
            "review": {"type": ["object", "null"]},
            "revision": {"type": "integer", "minimum": 1}
          },
          "required": ["constructor", "record_status", "review", "revision"]
        },
        "record_id": {"type": "string", "minLength": 1},
        "record_type": {"const": "transaction_provenance_schedule"},
        "verification_method": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "chain": {"type": "string", "minLength": 1},
            "chain_id": {"const": 1},
            "historical_method": {"type": "string", "minLength": 1},
            "primary_evidence": {"type": "string", "minLength": 1},
            "title_boundary": {"type": "string", "minLength": 1},
            "rpc_evidence": {"type": "string", "minLength": 1},
            "transfer_topic": {"type": "string", "minLength": 1}
          },
          "required": ["chain", "chain_id", "historical_method", "primary_evidence", "title_boundary"]
        }
      },
      "required": ["accession_lot_id", "common_receipt", "evidence_refs", "historical_event_boundary", "objects", "provenance_limits", "record_control", "record_id", "record_type", "verification_method"]
    }
  },
  "allOf": [
    {"$ref": "#/$defs/provenanceSchedule"},
    {
      "type": "object",
      "required": ["$schema"],
      "properties": {"$schema": {"type": "string", "minLength": 1}}
    }
  ]
}

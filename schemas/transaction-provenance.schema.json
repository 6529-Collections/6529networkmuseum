{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/transaction-provenance/v1",
  "title": "6529 Network Museum transaction and provenance schedule",
  "type": "object",
  "additionalProperties": true,
  "required": ["$schema", "record_control", "record_id", "record_type", "verification_method", "common_receipt", "objects"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"const": "transaction_provenance_schedule"},
    "record_control": {"type": "object", "required": ["revision", "record_status", "constructor", "review"]},
    "verification_method": {"type": "object", "required": ["chain", "rpc_evidence", "transfer_topic"]},
    "common_receipt": {"type": "object", "required": ["transaction_hash", "block_number", "block_time", "receipt_status", "transfer_count"]},
    "objects": {"type": "array", "minItems": 7}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/public-route-compatibility-v1.json",
  "title": "6529 Network Museum typed legacy route compatibility inventory",
  "type": "object",
  "properties": {
    "$schema": {"const": "https://6529networkmuseum.org/schemas/public-route-compatibility-v1.json"},
    "inventory_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "entries": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "legacy_route": {"type": "string", "pattern": "^/museum/network/[^\\s?#]+(?:\\?[^\\s#]+)?$"},
          "canonical_route": {"type": "string", "pattern": "^/museum/network/[^\\s]+$"},
          "target_kind": {"enum": ["entity", "route"]},
          "target_entity_id": {"type": ["string", "null"], "minLength": 1},
          "semantics": {"enum": ["permanent_redirect", "compatible_alias"]},
          "status": {"const": "permanent"}
        },
        "required": ["legacy_route", "canonical_route", "target_kind", "target_entity_id", "semantics", "status"],
        "allOf": [
          {"if": {"properties": {"target_kind": {"const": "entity"}}, "required": ["target_kind"]}, "then": {"not": {"properties": {"target_entity_id": {"const": null}}}}},
          {"if": {"properties": {"target_kind": {"const": "route"}}, "required": ["target_kind"]}, "then": {"properties": {"target_entity_id": {"const": null}}}}
        ],
        "unevaluatedProperties": false
      }
    },
    "include_governed_route_aliases": {"const": true},
    "expansions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "expansion_id": {"type": "string", "minLength": 1},
          "source_inventory": {"enum": ["work_aliases", "acquisition_aliases", "source_aliases", "approved_collections", "institutional_practice", "data_architecture", "rights", "governance"]},
          "alias_kind": {"type": "string", "minLength": 1},
          "legacy_templates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "canonical_route_from_entity": {"type": "boolean"},
          "only_permanent_collection": {"type": "boolean"},
          "semantics": {"enum": ["permanent_redirect", "compatible_alias"]},
          "path_transform": {"enum": ["identity", "approved_collection_to_gift_program", "institutional_practice_to_research", "data_architecture_to_research", "rights_to_research", "governance_to_about"]}
        },
        "required": ["expansion_id", "source_inventory", "alias_kind", "legacy_templates", "canonical_route_from_entity", "only_permanent_collection", "semantics", "path_transform"],
        "unevaluatedProperties": false
      }
    },
    "frontend_route_set": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "required": ["$schema", "inventory_version", "entries", "include_governed_route_aliases", "expansions", "frontend_route_set"],
  "unevaluatedProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/accession-register/v1",
  "title": "6529 Network Museum accession-lot register",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "record_control", "register_id", "snapshot_at", "lots"],
  "properties": {
    "$schema": {"const": "../../schemas/accession-register.schema.json"},
    "record_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "record_status", "constructor", "review"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "record_status": {"enum": ["constructed", "reviewed"]},
        "constructor": {"type": "object", "required": ["actor_id", "role", "constructed_at"]},
        "review": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["actor_id", "role", "reviewed_at", "outcome", "payload_sha256"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1},
            "role": {"const": "reviewer"},
            "reviewed_at": {"type": "string", "minLength": 20},
            "outcome": {"const": "approved"},
            "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "register_id": {"const": "6529NM-ACCESSION-REGISTER"},
    "snapshot_at": {"type": "string", "minLength": 20},
    "lots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accession_lot_id", "preferred_title", "object_count", "donation_status", "accession_status", "donor_public_credit", "custody", "receipt_event", "evidence_refs", "completion_limits"],
        "properties": {
          "accession_lot_id": {"type": "string", "pattern": "^6529NM\\.[0-9]{4}\\.[0-9]{3}$"},
          "preferred_title": {"type": "string", "minLength": 1},
          "object_count": {"type": "integer", "minimum": 1},
          "donation_status": {"const": "received"},
          "accession_status": {"const": "documentation_in_progress"},
          "donor_public_credit": {"type": "string", "minLength": 1},
          "custody": {"type": "object", "required": ["ens", "chain_id", "address", "observed_at", "evidence_class"]},
          "receipt_event": {"type": "object", "required": ["transaction_hash", "block_number", "block_time", "from", "to", "transfer_count", "receipt_status", "evidence_class"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "completion_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}

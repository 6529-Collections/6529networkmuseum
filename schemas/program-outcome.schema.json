{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529.network/museum/schemas/program-outcome/v1",
  "title": "6529 Network Museum selected-work program outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "record_control", "record_type", "schema_profile", "record_id", "program_id", "status", "as_of", "record_scope", "artist", "title", "title_as_submitted", "classification", "artist_statement", "media", "selection_evidence", "rights_and_consent", "mint_acquisition_custody_accession", "source_fixity", "non_claims"],
  "properties": {
    "$schema": {"const": "../../../../schemas/program-outcome.schema.json"},
    "record_control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "record_status", "constructor", "review"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "record_status": {"enum": ["constructed", "reviewed"]},
        "constructor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor_id", "role", "constructed_at"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1},
            "role": {"const": "constructor"},
            "constructed_at": {"type": "string", "minLength": 20}
          }
        },
        "review": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["actor_id", "role", "reviewed_at", "reviewed_commit", "outcome", "payload_sha256"],
          "properties": {
            "actor_id": {"type": "string", "minLength": 1},
            "role": {"const": "reviewer"},
            "reviewed_at": {"type": "string", "minLength": 20},
            "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "outcome": {"const": "approved"},
            "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        }
      }
    },
    "record_type": {"const": "PROGRAM_OUTCOME"},
    "schema_profile": {"const": "6529NM_PROGRAM_OUTCOME_V1"},
    "record_id": {"type": "string", "pattern": "^6529NM-AP-01-OUT-[0-9]{3}$"},
    "program_id": {"const": "6529NM-AP-01"},
    "status": {"const": "selected_unminted"},
    "as_of": {"type": "string", "minLength": 20},
    "record_scope": {"type": "string", "minLength": 1},
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "authority_status"],
      "properties": {
        "handle": {"type": "string", "minLength": 1},
        "authority_status": {"type": "string", "minLength": 1}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "title_as_submitted": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "minLength": 1},
    "artist_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "verbatim", "source_drop_part_id", "content_note"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "verbatim": {"const": true},
        "source_drop_part_id": {"type": "integer", "minimum": 0},
        "content_note": {"type": "string", "minLength": 1}
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "mime_type", "retrieval_status", "sha256"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://"},
          "mime_type": {"type": "string", "minLength": 1},
          "retrieval_status": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"]}
        }
      }
    },
    "selection_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave_id", "wave_url", "submission_drop_id", "submission_serial_no", "drop_type", "api_signed", "winner_place", "vote_total", "realtime_vote_total", "voter_count", "decision_at", "decision_at_basis", "observed_at", "selection_interpretation"],
      "properties": {
        "wave_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "wave_url": {"type": "string", "pattern": "^https://6529\\.io/waves/"},
        "submission_drop_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "submission_serial_no": {"type": "integer", "minimum": 1},
        "drop_type": {"const": "WINNER"},
        "api_signed": {"const": true},
        "winner_place": {"type": "integer", "minimum": 1},
        "vote_total": {"type": "integer", "minimum": 0},
        "realtime_vote_total": {"type": "integer", "minimum": 0},
        "voter_count": {"type": "integer", "minimum": 0},
        "decision_at": {"type": "string", "minLength": 20},
        "decision_at_basis": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "minLength": 20},
        "selection_interpretation": {"type": "string", "minLength": 1}
      }
    },
    "rights_and_consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_requirement", "artist_cc0_declaration", "artist_assertion_status", "consent_representation", "restricted_consent_instrument", "rights_effective_status"],
      "properties": {
        "program_requirement": {"type": "string", "minLength": 1},
        "artist_cc0_declaration": {"type": "string", "minLength": 1},
        "artist_assertion_status": {"type": "string", "minLength": 1},
        "license_interpretation": {"type": "string", "minLength": 1},
        "consent_representation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation_status", "documentation_status"],
          "properties": {
            "representation_status": {"type": "string", "minLength": 1},
            "documentation_status": {"type": "string", "minLength": 1},
            "source_text": {"type": "string", "minLength": 1}
          }
        },
        "restricted_consent_instrument": {"type": ["string", "null"]},
        "rights_effective_status": {"type": "string", "minLength": 1}
      }
    },
    "mint_acquisition_custody_accession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mint_status", "mint_topology_status", "mint_topology_options", "contract_address", "contract_deployment_transaction", "token_standard", "token_id", "caip19", "mint_transaction", "mint_block", "mint_timestamp", "purchase_status", "purchase_transaction", "purchase_price_eth", "title_binding", "planned_custody_reference", "custody_receipt_status", "custody_wallet", "custody_transfer_transaction", "custody_verification", "accession_status", "accession_number", "accession_statement_id", "accession_effective_at", "technical_verification_status", "preservation_status", "display_status"],
      "properties": {
        "mint_status": {"type": "string", "minLength": 1},
        "mint_topology_status": {"const": "undecided"},
        "mint_topology_options": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "contract_address": {"type": ["string", "null"]},
        "contract_deployment_transaction": {"type": ["string", "null"]},
        "token_standard": {"type": ["string", "null"]},
        "token_id": {"type": ["integer", "string", "null"]},
        "caip19": {"type": ["string", "null"]},
        "mint_transaction": {"type": ["string", "null"]},
        "mint_block": {"type": ["integer", "null"]},
        "mint_timestamp": {"type": ["string", "null"]},
        "purchase_status": {"const": "unverified"},
        "purchase_transaction": {"const": null},
        "purchase_price_eth": {"const": null},
        "title_binding": {"type": ["string", "null"]},
        "planned_custody_reference": {"const": "networkmuseum.6529.eth"},
        "custody_receipt_status": {"type": "string", "minLength": 1},
        "custody_wallet": {"type": ["string", "null"]},
        "custody_transfer_transaction": {"type": ["string", "null"]},
        "custody_verification": {"type": ["string", "null"]},
        "accession_status": {"const": "not_recorded"},
        "accession_number": {"type": ["string", "null"]},
        "accession_statement_id": {"type": ["string", "null"]},
        "accession_effective_at": {"type": ["string", "null"]},
        "technical_verification_status": {"type": "string", "minLength": 1},
        "preservation_status": {"type": "string", "minLength": 1},
        "display_status": {"type": "string", "minLength": 1}
      }
    },
    "source_fixity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_content_sha256", "hash_basis"],
      "properties": {
        "submission_content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "hash_basis": {"type": "string", "minLength": 1}
      }
    },
    "non_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

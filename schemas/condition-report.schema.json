{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/condition-report-v1.json",
  "allOf": [
    {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/commonPayload"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "CONDITION_REPORT"},
        "schema_id": {"const": "0x858704877558aaf0b797c652bf8620387145320c89bc6b31b997be9073b65e44"},
        "record_status": {"enum": ["constructed", "review_pending", "reviewed", "superseded"]},
        "review_status": {"enum": ["pending_independent_review", "reviewed", "superseded"]},
        "payload_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "object_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
        "protocol_state": {"type": "string", "minLength": 1},
        "assessments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "enum": ["green", "amber", "red", "not_assessed", "not_applicable"]}
        },
        "method": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "event_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
              "event_type": {"type": "string", "enum": ["condition_assessment", "condition_reassessment"]},
              "occurred_at": {"type": "string", "format": "date-time"},
              "supersedes_event_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
              "authority_reference": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
              "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/evidenceRef"}, "uniqueItems": true}
            },
            "required": ["event_id", "event_type", "occurred_at", "authority_reference", "evidence_refs"],
            "allOf": [
              {"if": {"properties": {"event_type": {"const": "condition_reassessment"}}}, "then": {"required": ["supersedes_event_id"]}}
            ],
            "unevaluatedProperties": false
          }
        }
      },
      "required": ["object_id", "protocol_state", "assessments", "method", "outcome", "observed_at", "events"]
    }
  ]
}

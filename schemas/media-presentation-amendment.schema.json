{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://6529networkmuseum.org/schemas/media-presentation-amendment-v1.json",
  "title": "6529 Network Museum append-only public media presentation amendment",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bytes32": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "dimensions": {
      "type": "object",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "basis": {"type": "string", "minLength": 1}
      },
      "required": ["width", "height", "basis"],
      "unevaluatedProperties": false
    },
    "priorCatalog": {
      "type": "object",
      "properties": {
        "catalog_id": {"type": "string", "pattern": "^6529NM-PUBCAT-[0-9a-f]{40}$"},
        "catalog_path": {"type": "string", "pattern": "^release-artifacts/catalog/[^\\\\]+\\.json$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "catalog_file_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_envelope_content_hash": {"$ref": "#/$defs/bytes32"}
      },
      "required": ["catalog_id", "catalog_path", "source_commit", "catalog_file_sha256", "catalog_envelope_content_hash"],
      "unevaluatedProperties": false
    },
    "priorRecord": {
      "type": "object",
      "properties": {
        "record_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "defect": {"type": "string", "minLength": 1}
      },
      "required": ["record_id", "payload_sha256", "defect"],
      "unevaluatedProperties": false
    },
    "presentationCorrection": {
      "type": "object",
      "properties": {
        "object_id": {"type": "string", "pattern": "^6529NM\\.2026\\.001\\.0[1-7]$"},
        "work_entity_id": {"type": "string", "pattern": "^6529NM-W-000[1-7]$"},
        "still_media_entity_id": {"type": "string", "pattern": "^6529NM-MED-00(?:4[5-9]|5[01])$"},
        "live_media_entity_id": {"type": "string", "pattern": "^6529NM-MED-001[0-6]$"},
        "rights_record_id": {"type": "string", "pattern": "^6529NM\\.2026\\.001\\.RIGHTS\\.0[1-7]$"},
        "license_url": {"const": "https://creativecommons.org/licenses/by-nc/4.0/"},
        "credit": {"type": "string", "minLength": 1},
        "accessibility_text": {"type": "string", "minLength": 1},
        "still": {
          "type": "object",
          "properties": {
            "source_url": {"type": "string", "pattern": "^https://media-proxy\\.artblocks\\.io/1/0x[0-9a-f]{40}/[0-9]+\\.png$"},
            "media_type": {"const": "image/png"},
            "response_sha256": {"$ref": "#/$defs/sha256"},
            "byte_size": {"type": "integer", "minimum": 1},
            "dimensions": {"$ref": "#/$defs/dimensions"},
            "source_status": {"const": "mutable_external"},
            "bytes_retained": {"const": false},
            "display_order": {"const": 1},
            "allowed_ui_affordances": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "view",
                  "thumbnail",
                  "hero",
                  "alt_text",
                  "zoom",
                  "fullscreen",
                  "open_token_source",
                  "copy_citation"
                ]
              }
            }
          },
          "required": ["source_url", "media_type", "response_sha256", "byte_size", "dimensions", "source_status", "bytes_retained", "display_order", "allowed_ui_affordances"],
          "unevaluatedProperties": false
        },
        "live": {
          "type": "object",
          "properties": {
            "source_url": {"type": "string", "pattern": "^https://generator\\.artblocks\\.io/1/0x[0-9a-f]{40}/[0-9]+$"},
            "media_type": {"const": "text/html"},
            "observed_canvas_dimensions": {"$ref": "#/$defs/dimensions"},
            "source_status": {"const": "mutable_external"},
            "bytes_retained": {"const": false},
            "display_order": {"const": 2},
            "accessibility_text": {"type": "string", "minLength": 1},
            "allowed_ui_affordances": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "contains": {"const": "interact_sandboxed"},
              "items": {
                "enum": [
                  "view",
                  "alt_text",
                  "interact_sandboxed",
                  "fullscreen",
                  "open_token_source",
                  "copy_citation"
                ]
              }
            }
          },
          "required": ["source_url", "media_type", "observed_canvas_dimensions", "source_status", "bytes_retained", "display_order", "accessibility_text", "allowed_ui_affordances"],
          "unevaluatedProperties": false
        }
      },
      "required": ["object_id", "work_entity_id", "still_media_entity_id", "live_media_entity_id", "rights_record_id", "license_url", "credit", "accessibility_text", "still", "live"],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/commonPayload"},
    {
      "type": "object",
      "properties": {
        "record_type": {"const": "MEDIA_PRESENTATION_AMENDMENT"},
        "schema_id": {"const": "0xf73b3115605e448cec9d5599dbc5e32dab4f3c91ab119bca2bac4aadc1f6ec9b"},
        "amendment_id": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"},
        "accession_lot_id": {"const": "6529NM.2026.001"},
        "amendment_state": {"enum": ["superseded_projection_snapshot", "active_correction"]},
        "prior_catalog": {"$ref": "#/$defs/priorCatalog"},
        "prior_public_record_commitments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/priorRecord"}
        },
        "defect_statement": {"type": "string", "minLength": 1},
        "correction_scope": {"type": "string", "minLength": 1},
        "presentation_corrections": {
          "type": "array",
          "minItems": 0,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/presentationCorrection"}
        },
        "immutable_boundaries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "prior_payload_sha256": {"$ref": "#/$defs/sha256"},
        "source_record_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://6529networkmuseum.org/schemas/common-v1.json#/$defs/id"}
        }
      },
      "required": ["amendment_id", "accession_lot_id", "amendment_state", "prior_catalog", "prior_public_record_commitments", "defect_statement", "correction_scope", "presentation_corrections", "immutable_boundaries", "source_record_ids"],
      "allOf": [
        {
          "if": {"properties": {"amendment_state": {"const": "active_correction"}}, "required": ["amendment_state"]},
          "then": {
            "required": ["supersedes", "supersession_reason", "prior_payload_sha256"],
            "properties": {"presentation_corrections": {"minItems": 7, "maxItems": 7}}
          },
          "else": {"properties": {"presentation_corrections": {"maxItems": 0}}}
        }
      ]
    }
  ],
  "unevaluatedProperties": false
}
